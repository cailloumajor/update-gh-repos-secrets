{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:goXPackagesChangelogLink",
    "helpers:goXPackagesNameLink",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automergeType": "branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * *"],
    "automerge": true
  },
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Disable update PRs (in favor of lock file maintenance) for mise tools with requested version being latest",
      "matchDepTypes": ["tools"],
      "matchCurrentValue": "latest",
      "enabled": false
    }
  ]
}
